# Backend environment. Copy to `.env` for local dev; in production these are
# set on the Render service (atoll-isle-api), not committed.

# Neon Postgres pooled connection string (…-pooler.neon.tech). Required.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Any long random string. Signs auth tokens — changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Stripe. Use test keys (sk_test_…) for a demo. Payment routes fail without.
STRIPE_SECRET_KEY=sk_test_xxx
# From the Stripe webhook endpoint config; leave blank if not using webhooks.
STRIPE_WEBHOOK_SECRET=

# Passkey / WebAuthn. RP_ID is the bare domain users register passkeys on;
# ORIGINS is a comma-separated list of full https origins allowed to use them.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:5174

# Set automatically by Render. Local dev falls back to 4000 if unset.
# PORT=4000
