# Where each destination app lives. In local dev the tourist/business/agent
# apps default to Vite's port 5173 and increment as ports get taken, so
# these assume you start them in this order (tourist, then business, then
# agent). In production, set all three to the real deployed URLs — nothing
# in the code needs to change.
VITE_TOURIST_APP_URL=http://localhost:5173
VITE_BUSINESS_APP_URL=http://localhost:5174
VITE_AGENT_APP_URL=http://localhost:5175
